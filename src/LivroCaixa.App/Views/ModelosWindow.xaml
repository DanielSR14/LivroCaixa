<Window x:Class="LivroCaixa.App.Views.ModelosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        Title="Modelos de lançamento"
        Height="520" Width="760"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/livrocaixa_icone.ico"
        Background="{StaticResource Brush.AppBackground}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Modelos de lançamento" Style="{StaticResource Text.Title}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="+ Novo modelo" Style="{StaticResource Button.Primary}"
                    Command="{Binding NovoModeloCommand}" />
        </Grid>

        <TextBlock Grid.Row="1" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,16"
                   Text="Para lançamentos que se repetem (aluguel, luz, tarifa do banco...). No novo lançamento, digite o código do modelo e o formulário é preenchido — é só conferir e salvar." />

        <TextBlock Grid.Row="2" Text="{Binding MensagemErro}" Style="{StaticResource Text.Field.Error}"
                   Visibility="{Binding MensagemErro, Converter={StaticResource TextoParaVisibilidadeConverter}}"
                   Margin="0,0,0,8" />

        <DataGrid Grid.Row="3" ItemsSource="{Binding Modelos}" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal"
                  BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                  RowHeight="40" HeadersVisibility="Column" Background="{StaticResource Brush.SurfaceBackground}"
                  VerticalContentAlignment="Center">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="80" FontWeight="SemiBold" />
                <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*" />
                <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo, Converter={StaticResource EnumParaTextoExibicaoConverter}}" Width="80" />
                <DataGridTextColumn Header="Categoria" Binding="{Binding NomeCategoria}" Width="140" />
                <DataGridTextColumn Header="Conta" Binding="{Binding NomeConta, TargetNullValue='—'}" Width="110" />
                <DataGridTextColumn Header="Valor" Binding="{Binding Valor, StringFormat={}{0:C2}, TargetNullValue='—'}" Width="100" />
                <DataGridTemplateColumn Header="" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource Button.Icon}" ToolTip="Editar"
                                        Command="{Binding DataContext.EditarModeloCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}">
                                    <Image Source="{svgc:SvgImage Source=/Assets/Icons/edit.svg}" Width="16" Height="16" />
                                </Button>
                                <Button Style="{StaticResource Button.Icon}" ToolTip="Excluir"
                                        Click="BotaoExcluir_Click" Tag="{Binding}">
                                    <Image Source="{svgc:SvgImage Source=/Assets/Icons/trash.svg}" Width="16" Height="16" />
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
