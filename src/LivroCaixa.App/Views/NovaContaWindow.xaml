<Window x:Class="LivroCaixa.App.Views.NovaContaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:enums="clr-namespace:LivroCaixa.Domain.Enums;assembly=LivroCaixa.Domain"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        Title="{Binding TituloJanela}"
        Width="380" MinHeight="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="/Assets/livrocaixa_icone.ico"
        Background="{StaticResource Brush.AppBackground}">
    <Window.Resources>
        <ObjectDataProvider x:Key="TiposConta" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enums:TipoConta" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="TiposContaBancaria" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enums:TipoContaBancaria" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
    </Window.Resources>

    <StackPanel Margin="24">
        <TextBlock Text="{Binding TituloJanela}" Style="{StaticResource Text.Title}" Margin="0,0,0,16" />

        <TextBlock Text="Tipo" Style="{StaticResource Text.Field.Label}" />
        <ComboBox Style="{StaticResource ComboBox.Default}" Margin="0,0,0,12"
                  ItemsSource="{Binding Source={StaticResource TiposConta}}"
                  SelectedItem="{Binding Tipo}" />

        <!-- Tipo == Banco: escolher o banco da lista + dados bancários. -->
        <StackPanel Visibility="{Binding MostrarCamposBanco, Converter={StaticResource BoolParaVisibilidade}}">
            <TextBlock Text="Banco" Style="{StaticResource Text.Field.Label}" />
            <ComboBox Style="{StaticResource ComboBox.Default}" Margin="0,0,0,12"
                      ItemsSource="{Binding BancosSugeridos}"
                      SelectedItem="{Binding BancoSelecionado}"
                      TextSearch.TextPath="Nome" IsTextSearchEnabled="True">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox Source="{Binding IconeCaminho}" Width="18" Height="18" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding Nome}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Agência" Style="{StaticResource Text.Field.Label}" />
                    <TextBox Style="{StaticResource TextBox.Default}"
                             Text="{Binding Agencia, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Conta" Style="{StaticResource Text.Field.Label}" />
                    <TextBox Style="{StaticResource TextBox.Default}"
                             Text="{Binding NumeroConta, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>

            <TextBlock Text="Conta corrente ou poupança" Style="{StaticResource Text.Field.Label}" />
            <ComboBox Style="{StaticResource ComboBox.Default}" Margin="0,0,0,12"
                      ItemsSource="{Binding Source={StaticResource TiposContaBancaria}}"
                      SelectedItem="{Binding TipoContaBancariaSelecionada}" />
        </StackPanel>

        <!-- Tipo != Banco (Caixa, Cartão, Investimento): só um nome livre. -->
        <StackPanel Visibility="{Binding MostrarNomeSimples, Converter={StaticResource BoolParaVisibilidade}}">
            <TextBlock Text="Nome" Style="{StaticResource Text.Field.Label}" />
            <TextBox Style="{StaticResource TextBox.Default}" Margin="0,0,0,4"
                     Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="Ex: Cofrinho, Cartão Nubank, Reserva de emergência..."
                       Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,12" />
        </StackPanel>

        <TextBlock Text="Saldo inicial (R$)" Style="{StaticResource Text.Field.Label}" />
        <TextBox Style="{StaticResource TextBox.Default}" Margin="0,0,0,4"
                 Text="{Binding SaldoInicialTexto, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Text="{Binding MensagemErro}" Style="{StaticResource Text.Field.Error}"
                   Visibility="{Binding MensagemErro, Converter={StaticResource TextoParaVisibilidadeConverter}}" />

        <Button Content="{Binding TextoBotaoSalvar}" Style="{StaticResource Button.Primary}"
                Command="{Binding SalvarCommand}" Margin="0,20,0,0"
                IsEnabled="{Binding EstaSalvando, Converter={StaticResource InverterBoolConverter}}" />
    </StackPanel>
</Window>
