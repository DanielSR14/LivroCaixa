<Window x:Class="LivroCaixa.App.Views.ArmazenamentoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        Title="Armazenamento"
        Height="560" Width="680"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/livrocaixa_icone.ico"
        Background="{StaticResource Brush.AppBackground}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <svgc:SvgViewbox Grid.Column="0" Source="/Assets/Icons/caixa.svg" Width="24" Height="24" Margin="0,0,10,0" />
            <TextBlock Grid.Column="1" Text="Armazenamento" Style="{StaticResource Text.Title}" VerticalAlignment="Center" />
        </Grid>
        <TextBlock Grid.Row="1" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="34,0,0,16"
                   Text="Espaço ocupado pelos comprovantes anexados, por competência. Só é possível apagar os comprovantes de uma competência depois que ela já foi exportada para o escritório — o arquivo já está salvo em outro lugar nesse caso. Os lançamentos em si nunca são apagados." />

        <UniformGrid Grid.Row="2" Columns="2" Margin="0,0,0,16">
            <Border Background="{StaticResource Brush.SurfaceBackground}" BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1" CornerRadius="12" Padding="20,16" Margin="0,0,12,0"
                    Effect="{StaticResource Effect.CardShadow}">
                <StackPanel>
                    <TextBlock Text="ESPAÇO OCUPADO" Style="{StaticResource Text.Field.Label}" />
                    <TextBlock Text="{Binding EspacoTotalExibicao}" Style="{StaticResource Text.Title}" />
                </StackPanel>
            </Border>
            <Border Background="{StaticResource Brush.SurfaceBackground}" BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1" CornerRadius="12" Padding="20,16"
                    Effect="{StaticResource Effect.CardShadow}">
                <StackPanel>
                    <TextBlock Text="COMPROVANTES" Style="{StaticResource Text.Field.Label}" />
                    <TextBlock Text="{Binding TotalComprovantes}" Style="{StaticResource Text.Title}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <StackPanel Grid.Row="3" Margin="0,0,0,8">
            <TextBlock Text="{Binding MensagemErro}" Style="{StaticResource Text.Field.Error}"
                       Visibility="{Binding MensagemErro, Converter={StaticResource TextoParaVisibilidadeConverter}}"
                       Margin="0,0,0,4" />
            <TextBlock Text="{Binding MensagemStatus}" Style="{StaticResource Text.Body}"
                       Visibility="{Binding MensagemStatus, Converter={StaticResource TextoParaVisibilidadeConverter}}" />
        </StackPanel>

        <Border Grid.Row="4" Background="{StaticResource Brush.SurfaceBackground}" BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1" CornerRadius="12" Effect="{StaticResource Effect.CardShadow}">
            <DataGrid ItemsSource="{Binding Competencias}" AutoGenerateColumns="False"
                      IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      RowHeight="48" HeadersVisibility="Column" Background="Transparent"
                      VerticalContentAlignment="Center">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource Brush.SurfaceHover}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Competência" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <svgc:SvgViewbox Source="/Assets/Icons/calendar.svg" Width="14" Height="14" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding CompetenciaExibicao}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Lançamentos" Binding="{Binding QuantidadeLancamentos}" Width="100" />
                    <DataGridTextColumn Header="Comprovantes" Binding="{Binding QuantidadeAnexos}" Width="110" />
                    <DataGridTextColumn Header="Espaço ocupado" Binding="{Binding TamanhoExibicao}" Width="110" />
                    <DataGridTemplateColumn Header="Status" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Brush.AppBackground}" CornerRadius="10"
                                        Padding="8,3" HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding JaExportada}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource Brush.PrimaryTint}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding StatusExportacaoExibicao}" Style="{StaticResource Text.Caption}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Limpar" Style="{StaticResource Button.Danger}" Tag="{Binding}"
                                        IsEnabled="{Binding JaExportada}"
                                        Click="BotaoLimpar_Click" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>
