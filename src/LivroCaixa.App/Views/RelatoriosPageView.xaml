<UserControl x:Class="LivroCaixa.App.Views.RelatoriosPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
    </UserControl.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="180" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Relatórios" Style="{StaticResource Text.Title}" VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Width="130">
                <TextBlock Text="Mês" Style="{StaticResource Text.Field.Label}" />
                <ComboBox Style="{StaticResource ComboBox.Default}"
                          ItemsSource="{Binding MesesDisponiveis}"
                          DisplayMemberPath="Nome" SelectedValuePath="Numero"
                          SelectedValue="{Binding Mes}" />
            </StackPanel>

            <StackPanel Grid.Column="3" Width="90">
                <TextBlock Text="Ano" Style="{StaticResource Text.Field.Label}" />
                <ComboBox Style="{StaticResource ComboBox.Default}"
                          ItemsSource="{Binding AnosDisponiveis}"
                          SelectedItem="{Binding Ano}" />
            </StackPanel>

            <StackPanel Grid.Column="5">
                <TextBlock Text="Conta" Style="{StaticResource Text.Field.Label}" />
                <ComboBox Style="{StaticResource ComboBox.Default}"
                          ItemsSource="{Binding ContasDisponiveis}"
                          DisplayMemberPath="Nome"
                          SelectedItem="{Binding ContaSelecionada}" />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="1" Text="{Binding MensagemErro}" Style="{StaticResource Text.Field.Error}"
                   Visibility="{Binding MensagemErro, Converter={StaticResource TextoParaVisibilidadeConverter}}"
                   Margin="0,0,0,8" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Resumo do período -->
                <UniformGrid Columns="3" Margin="0,0,0,16">
                    <Border Background="{StaticResource Brush.SurfaceBackground}" BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1" CornerRadius="12" Padding="20,16" Margin="0,0,8,0"
                            Effect="{StaticResource Effect.CardShadow}">
                        <StackPanel>
                            <TextBlock Text="ENTRADAS" Style="{StaticResource Text.Field.Label}" />
                            <TextBlock Text="{Binding TotalEntradas, StringFormat={}{0:C2}}" Style="{StaticResource Text.Title}"
                                       Foreground="{StaticResource Brush.Success}" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource Brush.SurfaceBackground}" BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1" CornerRadius="12" Padding="20,16" Margin="4,0,4,0"
                            Effect="{StaticResource Effect.CardShadow}">
                        <StackPanel>
                            <TextBlock Text="SAÍDAS" Style="{StaticResource Text.Field.Label}" />
                            <TextBlock Text="{Binding TotalSaidas, StringFormat={}{0:C2}}" Style="{StaticResource Text.Title}"
                                       Foreground="{StaticResource Brush.Error}" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource Brush.SurfaceBackground}" BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1" CornerRadius="12" Padding="20,16" Margin="8,0,0,0"
                            Effect="{StaticResource Effect.CardShadow}">
                        <StackPanel>
                            <TextBlock Text="RESULTADO" Style="{StaticResource Text.Field.Label}" />
                            <TextBlock Text="{Binding Resultado, StringFormat={}{0:C2}}" Style="{StaticResource Text.Title}"
                                       Foreground="{Binding Resultado, Converter={StaticResource ValorParaCorConverter}}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Comparação com outra competência -->
                <Border Background="{StaticResource Brush.SurfaceBackground}" BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16" Effect="{StaticResource Effect.CardShadow}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" Content="Comparar com outro mês" VerticalAlignment="Center"
                                      IsChecked="{Binding CompararAtivo}" />
                            <StackPanel Grid.Column="1" Width="130" Visibility="{Binding CompararAtivo, Converter={StaticResource BoolParaVisibilidade}}">
                                <ComboBox Style="{StaticResource ComboBox.Default}"
                                          ItemsSource="{Binding MesesDisponiveis}"
                                          DisplayMemberPath="Nome" SelectedValuePath="Numero"
                                          SelectedValue="{Binding MesComparacao}" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Width="90" Visibility="{Binding CompararAtivo, Converter={StaticResource BoolParaVisibilidade}}">
                                <ComboBox Style="{StaticResource ComboBox.Default}"
                                          ItemsSource="{Binding AnosDisponiveis}"
                                          SelectedItem="{Binding AnoComparacao}" />
                            </StackPanel>
                        </Grid>

                        <UniformGrid Columns="2" Margin="0,16,0,0"
                                     Visibility="{Binding CompararAtivo, Converter={StaticResource BoolParaVisibilidade}}">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="{Binding CompetenciaPrincipalExibicao, StringFormat={}Este período ({0})}"
                                           Style="{StaticResource Text.Field.Label}" Margin="0,0,0,8" />
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Entradas" Style="{StaticResource Text.Caption}" HorizontalAlignment="Left" />
                                    <TextBlock Text="{Binding TotalEntradas, StringFormat={}{0:C2}}" Style="{StaticResource Text.Body}"
                                               Foreground="{StaticResource Brush.Success}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Saídas" Style="{StaticResource Text.Caption}" HorizontalAlignment="Left" />
                                    <TextBlock Text="{Binding TotalSaidas, StringFormat={}{0:C2}}" Style="{StaticResource Text.Body}"
                                               Foreground="{StaticResource Brush.Error}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Resultado" Style="{StaticResource Text.Caption}" HorizontalAlignment="Left" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Resultado, StringFormat={}{0:C2}}" Style="{StaticResource Text.Body}" FontWeight="SemiBold"
                                               Foreground="{Binding Resultado, Converter={StaticResource ValorParaCorConverter}}" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="{Binding CompetenciaComparacaoExibicao}"
                                           Style="{StaticResource Text.Field.Label}" Margin="0,0,0,8" />
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Entradas" Style="{StaticResource Text.Caption}" HorizontalAlignment="Left" />
                                    <TextBlock Text="{Binding TotalEntradasComparacao, StringFormat={}{0:C2}}" Style="{StaticResource Text.Body}"
                                               Foreground="{StaticResource Brush.Success}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Saídas" Style="{StaticResource Text.Caption}" HorizontalAlignment="Left" />
                                    <TextBlock Text="{Binding TotalSaidasComparacao, StringFormat={}{0:C2}}" Style="{StaticResource Text.Body}"
                                               Foreground="{StaticResource Brush.Error}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Resultado" Style="{StaticResource Text.Caption}" HorizontalAlignment="Left" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ResultadoComparacao, StringFormat={}{0:C2}}" Style="{StaticResource Text.Body}" FontWeight="SemiBold"
                                               Foreground="{Binding ResultadoComparacao, Converter={StaticResource ValorParaCorConverter}}" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- Resultado por categoria -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource Brush.SurfaceBackground}" BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1" CornerRadius="12" Padding="20" Effect="{StaticResource Effect.CardShadow}">
                        <StackPanel>
                            <TextBlock Text="Entradas por categoria" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,12" />
                            <ItemsControl ItemsSource="{Binding EntradasPorCategoria}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="90" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Categoria}" Style="{StaticResource Text.Body}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <Border Grid.Column="1" Height="10" Background="{StaticResource Brush.AppBackground}"
                                                    CornerRadius="4" Margin="8,0" VerticalAlignment="Center">
                                                <Border Width="{Binding PercentualBarra}" HorizontalAlignment="Left"
                                                        Background="{StaticResource Brush.Success}" CornerRadius="4" />
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{Binding Total, StringFormat={}{0:C2}}"
                                                       Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Nenhuma entrada nesta competência." Style="{StaticResource Text.Caption}"
                                       Visibility="{Binding EntradasPorCategoria.Count, Converter={StaticResource ContagemZeroParaVisibilidadeConverter}}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="{StaticResource Brush.SurfaceBackground}" BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1" CornerRadius="12" Padding="20" Effect="{StaticResource Effect.CardShadow}">
                        <StackPanel>
                            <TextBlock Text="Saídas por categoria" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,12" />
                            <ItemsControl ItemsSource="{Binding SaidasPorCategoria}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="90" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Categoria}" Style="{StaticResource Text.Body}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <Border Grid.Column="1" Height="10" Background="{StaticResource Brush.AppBackground}"
                                                    CornerRadius="4" Margin="8,0" VerticalAlignment="Center">
                                                <Border Width="{Binding PercentualBarra}" HorizontalAlignment="Left"
                                                        Background="{StaticResource Brush.Error}" CornerRadius="4" />
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{Binding Total, StringFormat={}{0:C2}}"
                                                       Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Nenhuma saída nesta competência." Style="{StaticResource Text.Caption}"
                                       Visibility="{Binding SaidasPorCategoria.Count, Converter={StaticResource ContagemZeroParaVisibilidadeConverter}}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Fluxo de caixa acumulado -->
                <Border Background="{StaticResource Brush.SurfaceBackground}" BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16" Effect="{StaticResource Effect.CardShadow}">
                    <StackPanel>
                        <TextBlock Text="Fluxo de caixa acumulado (últimos 6 meses)" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding FluxoDeCaixa}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="110" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding MesExibicao}" Style="{StaticResource Text.Body}"
                                                   VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Height="12" Background="{StaticResource Brush.AppBackground}"
                                                CornerRadius="4" Margin="8,0" VerticalAlignment="Center">
                                            <Border Width="{Binding PercentualBarra}" HorizontalAlignment="Left" CornerRadius="4"
                                                    Background="{Binding SaldoFinal, Converter={StaticResource ValorParaCorConverter}}" />
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding SaldoFinal, StringFormat={}{0:C2}}"
                                                   Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Extrato estilo bancário -->
                <Border Background="{StaticResource Brush.SurfaceBackground}" BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="1" CornerRadius="12" Effect="{StaticResource Effect.CardShadow}">
                    <StackPanel>
                        <TextBlock Text="Extrato do período" Style="{StaticResource Text.Subtitle}" Margin="20,20,20,8" />
                        <DataGrid ItemsSource="{Binding Extrato}" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal"
                                  BorderThickness="0" MaxHeight="360"
                                  RowHeight="40" HeadersVisibility="Column" Background="Transparent"
                                  VerticalContentAlignment="Center">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Brush.SurfaceHover}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Data" Binding="{Binding Data, StringFormat=dd/MM/yyyy}" Width="90" />
                                <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="*" />
                                <DataGridTextColumn Header="Categoria" Binding="{Binding Categoria}" Width="140" />
                                <DataGridTextColumn Header="Conta" Binding="{Binding Conta}" Width="120" />
                                <DataGridTemplateColumn Header="Valor" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Valor, StringFormat={}{0:C2}}"
                                                       Foreground="{Binding Tipo, Converter={StaticResource TipoLancamentoParaCorConverter}}"
                                                       HorizontalAlignment="Right" Margin="0,0,8,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Saldo da conta" Binding="{Binding SaldoAposLancamento, StringFormat={}{0:C2}}" Width="130" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="Nenhum lançamento nesta competência." Style="{StaticResource Text.Caption}"
                                   Margin="20,0,20,20"
                                   Visibility="{Binding Extrato.Count, Converter={StaticResource ContagemZeroParaVisibilidadeConverter}}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
