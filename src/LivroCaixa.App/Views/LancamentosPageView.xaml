<UserControl x:Class="LivroCaixa.App.Views.LancamentosPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
    </UserControl.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Lançamentos" Style="{StaticResource Text.Title}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Transferir entre contas" Style="{StaticResource Button.Secondary}" Margin="0,0,12,0"
                        Command="{Binding NovaTransferenciaCommand}"
                        ToolTip="Ex: saque do banco para o caixa. Não conta como entrada nem saída." />
                <Button Content="+ Novo lançamento" Style="{StaticResource Button.Primary}"
                        Command="{Binding NovoLancamentoCommand}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Buscar na descrição" Style="{StaticResource Text.Field.Label}" />
                <TextBox Style="{StaticResource TextBox.Default}"
                         Text="{Binding TextoBusca, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Procura na descrição e nas observações dos lançamentos" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Conta" Style="{StaticResource Text.Field.Label}" />
                <ComboBox Style="{StaticResource ComboBox.Default}" ItemsSource="{Binding ContasParaFiltro}"
                          SelectedItem="{Binding FiltroConta}" />
            </StackPanel>

            <StackPanel Grid.Column="4">
                <TextBlock Text="Categoria" Style="{StaticResource Text.Field.Label}" />
                <ComboBox Style="{StaticResource ComboBox.Default}" ItemsSource="{Binding CategoriasParaFiltro}"
                          SelectedItem="{Binding FiltroCategoria}" />
            </StackPanel>

            <StackPanel Grid.Column="6">
                <TextBlock Text="De" Style="{StaticResource Text.Field.Label}" />
                <DatePicker SelectedDate="{Binding FiltroDataInicio}" Width="120" />
            </StackPanel>

            <StackPanel Grid.Column="8">
                <TextBlock Text="Até" Style="{StaticResource Text.Field.Label}" />
                <DatePicker SelectedDate="{Binding FiltroDataFim}" Width="120" />
            </StackPanel>

            <Button Grid.Column="10" Content="Limpar filtros" Style="{StaticResource Button.Secondary}"
                    Command="{Binding LimparFiltrosCommand}" VerticalAlignment="Bottom" />

            <CheckBox Grid.Column="12" Content="Mostrar excluídos" VerticalAlignment="Bottom"
                      IsChecked="{Binding ExibirExcluidos}" />
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding MensagemErro}" Style="{StaticResource Text.Field.Error}"
                   Visibility="{Binding MensagemErro, Converter={StaticResource TextoParaVisibilidadeConverter}}"
                   Margin="0,0,0,8" />

        <DataGrid Grid.Row="3" ItemsSource="{Binding LancamentosFiltrados}" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal"
                  BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                  RowHeight="44" HeadersVisibility="Column" Background="{StaticResource Brush.SurfaceBackground}"
                  VerticalContentAlignment="Center" MouseDoubleClick="GradeLancamentos_MouseDoubleClick"
                  KeyDown="GradeLancamentos_KeyDown" x:Name="GradeLancamentos">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="Transparent" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource Brush.SurfaceHover}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <!-- Indicador visual rápido: verde = entrada, vermelho = saída. -->
                <DataGridTemplateColumn Header="" Width="6" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Width="4" HorizontalAlignment="Left" Margin="0,4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource Brush.Success}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Tipo}" Value="Saida">
                                                <Setter Property="Background" Value="{StaticResource Brush.Error}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Data" Binding="{Binding Data, StringFormat=dd/MM/yyyy}" Width="100" />

                <DataGridTemplateColumn Header="Descrição" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <svgc:SvgViewbox Source="/Assets/Icons/edit.svg" Width="12" Height="12" Margin="0,0,6,0"
                                                  Opacity="0.5" ToolTip="Este lançamento foi editado"
                                                  Visibility="{Binding FoiEditado, Converter={StaticResource BoolParaVisibilidade}}" />
                                <TextBlock Text="{Binding Descricao}" Style="{StaticResource Text.Body}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Categoria" Binding="{Binding Categoria}" Width="150" />

                <DataGridTemplateColumn Header="Conta" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="14" Height="14" Margin="0,0,6,0">
                                    <svgc:SvgViewbox Source="{Binding Conta, Converter={StaticResource NomeContaParaIconeBancoConverter}}"
                                                      Visibility="{Binding Conta, Converter={StaticResource NomeContaTemLogoBancoConverter}}" />
                                    <svgc:SvgViewbox Source="{Binding TipoConta, Converter={StaticResource TipoContaParaIconeConverter}}"
                                                      Visibility="{Binding Conta, Converter={StaticResource NomeContaTemLogoBancoConverter}, ConverterParameter=Inverso}" />
                                </Grid>
                                <TextBlock Text="{Binding Conta}" Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Valor" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Valor, StringFormat={}{0:C2}}"
                                       HorizontalAlignment="Right" Margin="0,0,8,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Success}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Tipo}" Value="Saida">
                                                <Setter Property="Foreground" Value="{StaticResource Brush.Error}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Saldo" Binding="{Binding SaldoAposLancamento, StringFormat={}{0:C2}}" Width="130" />

                <DataGridTemplateColumn Header="Anexos" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding QuantidadeAnexos}" HorizontalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <!-- Transferência não tem tela de detalhe nem edição (corrige-se excluindo e registrando de novo). -->
                                <Button Style="{StaticResource Button.Icon}" ToolTip="Exibir"
                                        Click="BotaoVer_Click" Tag="{Binding Id}"
                                        Visibility="{Binding EhTransferencia, Converter={StaticResource BoolInvertidoParaVisibilidadeConverter}}">
                                    <Image Source="{svgc:SvgImage Source=/Assets/Icons/eye.svg}" Width="16" Height="16" />
                                </Button>
                                <Button Style="{StaticResource Button.Icon}" ToolTip="Editar"
                                        Command="{Binding DataContext.EditarLancamentoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding Id}"
                                        Visibility="{Binding EhTransferencia, Converter={StaticResource BoolInvertidoParaVisibilidadeConverter}}">
                                    <Image Source="{svgc:SvgImage Source=/Assets/Icons/edit.svg}" Width="16" Height="16" />
                                </Button>
                                <Button Style="{StaticResource Button.Icon}" ToolTip="Excluir"
                                        Click="BotaoExcluir_Click" Tag="{Binding}">
                                    <Image Source="{svgc:SvgImage Source=/Assets/Icons/trash.svg}" Width="16" Height="16" />
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Lançamentos excluídos (exclusão lógica) — auditoria: ficam visíveis por aqui, com opção de restaurar. -->
        <Border Grid.Row="4" Margin="0,16,0,0" Background="{StaticResource Brush.SurfaceBackground}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="12"
                Visibility="{Binding ExibirExcluidos, Converter={StaticResource BoolParaVisibilidade}}">
            <StackPanel>
                <TextBlock Text="Lançamentos excluídos" Style="{StaticResource Text.Subtitle}" Margin="16,16,16,8" />
                <DataGrid ItemsSource="{Binding Excluidos}" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal"
                          BorderThickness="0" MaxHeight="220"
                          RowHeight="40" HeadersVisibility="Column" Background="Transparent"
                          VerticalContentAlignment="Center">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Opacity" Value="0.6" />
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Data" Binding="{Binding Data, StringFormat=dd/MM/yyyy}" Width="100" />
                        <DataGridTemplateColumn Header="Descrição" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Descricao}" Style="{StaticResource Text.Body}" TextDecorations="Strikethrough" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Categoria" Binding="{Binding Categoria}" Width="150" />
                        <DataGridTextColumn Header="Conta" Binding="{Binding Conta}" Width="120" />
                        <DataGridTemplateColumn Header="Valor" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Valor, StringFormat={}{0:C2}}" HorizontalAlignment="Right" Margin="0,0,8,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Restaurar" Style="{StaticResource Button.Secondary}" Padding="8,3"
                                            Command="{Binding DataContext.RestaurarLancamentoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding Id}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="Nenhum lançamento excluído." Style="{StaticResource Text.Caption}" Margin="16,0,16,16"
                           Visibility="{Binding Excluidos.Count, Converter={StaticResource ContagemZeroParaVisibilidadeConverter}}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
