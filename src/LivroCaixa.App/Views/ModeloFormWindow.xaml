<Window x:Class="LivroCaixa.App.Views.ModeloFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:enums="clr-namespace:LivroCaixa.Domain.Enums;assembly=LivroCaixa.Domain"
        Title="{Binding TituloJanela}"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="/Assets/livrocaixa_icone.ico"
        Background="{StaticResource Brush.AppBackground}">
    <Window.Resources>
        <ObjectDataProvider x:Key="FormasPagamento" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enums:FormaPagamento" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>

    <StackPanel Margin="24">
        <TextBlock Text="{Binding TituloJanela}" Style="{StaticResource Text.Title}" Margin="0,0,0,16" />

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Código" Style="{StaticResource Text.Field.Label}" />
                <TextBox Style="{StaticResource TextBox.Default}" CharacterCasing="Upper"
                         MaxLength="{Binding TamanhoMaximoCodigo, Mode=OneTime}"
                         Text="{Binding Codigo, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Curto e fácil de lembrar, ex: ALU, LUZ, TARIFA" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Nome" Style="{StaticResource Text.Field.Label}" />
                <TextBox Style="{StaticResource TextBox.Default}"
                         Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </Grid>

        <TextBlock Text="Categoria (define se é entrada ou saída)" Style="{StaticResource Text.Field.Label}" />
        <ComboBox Style="{StaticResource ComboBox.Default}" Margin="0,0,0,12"
                  ItemsSource="{Binding Categorias}" SelectedItem="{Binding CategoriaSelecionada}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock>
                        <Run Text="{Binding Nome, Mode=OneWay}" />
                        <Run Text="{Binding Tipo, Mode=OneWay, Converter={StaticResource EnumParaTextoExibicaoConverter}, StringFormat='({0})'}"
                             Foreground="{StaticResource Brush.TextSecondary}" />
                    </TextBlock>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Text="Conta padrão (opcional)" Style="{StaticResource Text.Field.Label}" />
        <ComboBox Style="{StaticResource ComboBox.Default}" Margin="0,0,0,12"
                  ItemsSource="{Binding Contas}" DisplayMemberPath="Nome"
                  SelectedItem="{Binding ContaSelecionada}" />

        <TextBlock Text="Forma de pagamento" Style="{StaticResource Text.Field.Label}" />
        <ComboBox Style="{StaticResource ComboBox.Default}" Margin="0,0,0,12"
                  ItemsSource="{Binding Source={StaticResource FormasPagamento}}"
                  SelectedItem="{Binding FormaPagamento}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource EnumParaTextoExibicaoConverter}}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Text="Valor padrão em R$ (opcional — deixe em branco se muda todo mês)" Style="{StaticResource Text.Field.Label}" />
        <TextBox Style="{StaticResource TextBox.Default}" Margin="0,0,0,12"
                 Text="{Binding ValorTexto, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Text="Descrição padrão (opcional)" Style="{StaticResource Text.Field.Label}" />
        <TextBox Style="{StaticResource TextBox.Default}" Margin="0,0,0,8"
                 Text="{Binding Descricao, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Text="{Binding MensagemErro}" Style="{StaticResource Text.Field.Error}"
                   Visibility="{Binding MensagemErro, Converter={StaticResource TextoParaVisibilidadeConverter}}" />

        <Button Content="Salvar" Style="{StaticResource Button.Primary}" IsDefault="True"
                Command="{Binding SalvarCommand}" Margin="0,16,0,0" />
    </StackPanel>
</Window>
