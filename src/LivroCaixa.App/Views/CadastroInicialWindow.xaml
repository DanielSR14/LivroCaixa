<Window x:Class="LivroCaixa.App.Views.CadastroInicialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Livro Caixa — Cadastro inicial"
        Height="640" Width="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Icon="/Assets/livrocaixa_icone.ico"
        Background="{StaticResource Brush.AppBackground}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32">
        <StackPanel MaxWidth="360" HorizontalAlignment="Center">
            <Image Source="/Assets/livrocaixa_logo.png" RenderOptions.BitmapScalingMode="HighQuality" Width="180" Stretch="Uniform"
                   HorizontalAlignment="Center" Margin="0,0,0,16" />

            <TextBlock Text="Vamos configurar sua empresa" Style="{StaticResource Text.Title}"
                       HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,4" />
            <TextBlock Text="Esses dados aparecem nos seus relatórios e na exportação para o escritório."
                       Style="{StaticResource Text.Caption}" HorizontalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,24" />

            <TextBlock Text="Razão social" Style="{StaticResource Text.Field.Label}" />
            <TextBox Style="{StaticResource TextBox.Default}" Margin="0,0,0,12"
                     Text="{Binding RazaoSocial, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Nome fantasia (opcional)" Style="{StaticResource Text.Field.Label}" />
            <TextBox Style="{StaticResource TextBox.Default}" Margin="0,0,0,12"
                     Text="{Binding NomeFantasia, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="CNPJ" Style="{StaticResource Text.Field.Label}" />
            <TextBox x:Name="CampoCnpj" Style="{StaticResource TextBox.Default}" Margin="0,0,0,12"
                     MaxLength="18" TextChanged="CampoCnpj_TextChanged"
                     Text="{Binding Cnpj, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Segmento (opcional)" Style="{StaticResource Text.Field.Label}" />
            <ComboBox Style="{StaticResource ComboBox.Default}" Margin="0,0,0,4"
                      ItemsSource="{Binding SegmentosDisponiveis}"
                      SelectedItem="{Binding Segmento}" />
            <TextBlock Text="Usamos isso para já sugerir categorias de lançamento comuns ao seu tipo de negócio."
                       Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,12" />

            <TextBlock Text="Seu nome (usuário administrador)" Style="{StaticResource Text.Field.Label}" />
            <TextBox Style="{StaticResource TextBox.Default}" Margin="0,0,0,12"
                     Text="{Binding NomeUsuario, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Senha" Style="{StaticResource Text.Field.Label}" />
            <PasswordBox x:Name="CampoSenha" Style="{StaticResource PasswordBox.Default}" Margin="0,0,0,12"
                         PasswordChanged="CampoSenha_PasswordChanged" />

            <TextBlock Text="Confirmar senha" Style="{StaticResource Text.Field.Label}" />
            <PasswordBox x:Name="CampoConfirmarSenha" Style="{StaticResource PasswordBox.Default}" Margin="0,0,0,4"
                         PasswordChanged="CampoConfirmarSenha_PasswordChanged" />

            <TextBlock Text="{Binding MensagemErro}" Style="{StaticResource Text.Field.Error}"
                       Visibility="{Binding MensagemErro, Converter={StaticResource TextoParaVisibilidadeConverter}}" />

            <Button Content="Criar minha empresa" Style="{StaticResource Button.Primary}"
                    Command="{Binding CadastrarCommand}" Margin="0,20,0,0"
                    IsEnabled="{Binding EstaSalvando, Converter={StaticResource InverterBoolConverter}}" />
        </StackPanel>
    </ScrollViewer>
</Window>
