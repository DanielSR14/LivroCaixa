<Window x:Class="LivroCaixa.App.Views.NovaCategoriaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:enums="clr-namespace:LivroCaixa.Domain.Enums;assembly=LivroCaixa.Domain"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        Title="{Binding TituloJanela}"
        Height="300" Width="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="/Assets/livrocaixa_icone.ico"
        Background="{StaticResource Brush.AppBackground}">
    <Window.Resources>
        <ObjectDataProvider x:Key="TiposLancamentoCategoria" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enums:TipoLancamento" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
    </Window.Resources>

    <StackPanel Margin="24">
        <TextBlock Text="{Binding TituloJanela}" Style="{StaticResource Text.Title}" Margin="0,0,0,16" />

        <TextBlock Text="Nome" Style="{StaticResource Text.Field.Label}" />
        <TextBox Style="{StaticResource TextBox.Default}" Margin="0,0,0,12"
                 Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Text="Tipo" Style="{StaticResource Text.Field.Label}" />
        <ComboBox Style="{StaticResource ComboBox.Default}" Margin="0,0,0,4"
                  ItemsSource="{Binding Source={StaticResource TiposLancamentoCategoria}}"
                  SelectedItem="{Binding Tipo}"
                  IsEnabled="{Binding PodeEditarTipo}" />
        <TextBlock Text="O tipo não pode ser alterado depois de criada a categoria."
                   Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,4"
                   Visibility="{Binding EstaEditando, Converter={StaticResource BoolParaVisibilidade}}" />

        <TextBlock Text="{Binding MensagemErro}" Style="{StaticResource Text.Field.Error}"
                   Visibility="{Binding MensagemErro, Converter={StaticResource TextoParaVisibilidadeConverter}}" />

        <Button Content="{Binding TextoBotaoSalvar}" Style="{StaticResource Button.Primary}"
                Command="{Binding SalvarCommand}" Margin="0,20,0,0"
                IsEnabled="{Binding EstaSalvando, Converter={StaticResource InverterBoolConverter}}" />
    </StackPanel>
</Window>
