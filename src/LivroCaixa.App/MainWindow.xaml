<Window x:Class="LivroCaixa.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LivroCaixa.App"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        mc:Ignorable="d"
        Title="Livro Caixa" Height="720" Width="1150" MinHeight="560" MinWidth="900"
        WindowState="Maximized"
        Icon="/Assets/livrocaixa_icone.ico"
        Background="{StaticResource Brush.AppBackground}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar: largura anima entre 240 (expandida) e 0 (recolhida) via code-behind.
             Modo "ícone apenas" fica para quando os ícones (REESTRUTURACAO_VISUAL.md item 6)
             existirem — por ora, recolher esconde a sidebar inteira. -->
        <Border x:Name="SidebarBorder" Grid.Column="0" Width="240" ClipToBounds="True"
                Background="{StaticResource Brush.SidebarBackground}">
            <DockPanel LastChildFill="False" Width="240">
                <StackPanel DockPanel.Dock="Top" Margin="16,20,16,20">
                    <Image Source="{svgc:SvgImage Source=/Assets/livrocaixa_logo.svg}" Height="36" Stretch="Uniform"
                           HorizontalAlignment="Center" Margin="0,0,0,8" />

                    <Border Background="{StaticResource Brush.SidebarItemHover}" CornerRadius="8" Padding="6,2"
                            HorizontalAlignment="Center" Margin="0,0,0,20" ToolTip="Este app está em fase de testes.">
                        <TextBlock Text="VERSÃO BETA" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.SidebarTextoSecundario}" />
                    </Border>

                    <Button Content="Dashboard" Style="{StaticResource Button.SidebarItem}"
                            Command="{Binding IrParaDashboardCommand}"
                            Background="{Binding PaginaSelecionada, Converter={StaticResource PaginaAtivaParaBrushConverter}, ConverterParameter=Dashboard}" />
                    <Button Content="Lançamentos" Style="{StaticResource Button.SidebarItem}"
                            Command="{Binding IrParaLancamentosCommand}"
                            Background="{Binding PaginaSelecionada, Converter={StaticResource PaginaAtivaParaBrushConverter}, ConverterParameter=Lancamentos}" />
                    <Button Content="Relatórios" Style="{StaticResource Button.SidebarItem}"
                            Command="{Binding IrParaRelatoriosCommand}"
                            Background="{Binding PaginaSelecionada, Converter={StaticResource PaginaAtivaParaBrushConverter}, ConverterParameter=Relatorios}" />

                    <Border Height="1" Background="{StaticResource Brush.SidebarItemHover}" Margin="4,12" />

                    <Button Content="Contas" Style="{StaticResource Button.SidebarItem}"
                            Command="{Binding AbrirContasCommand}" />
                    <Button Content="Categorias" Style="{StaticResource Button.SidebarItem}"
                            Command="{Binding AbrirCategoriasCommand}" />
                    <Button Content="Modelos de lançamento" Style="{StaticResource Button.SidebarItem}"
                            Command="{Binding AbrirModelosCommand}" />
                    <Button Content="Exportar p/ escritório" Style="{StaticResource Button.SidebarItem}"
                            Command="{Binding AbrirExportarCommand}" />
                    <Button Content="Armazenamento" Style="{StaticResource Button.SidebarItem}"
                            Command="{Binding AbrirArmazenamentoCommand}" />
                    <Button Content="Configurações" Style="{StaticResource Button.SidebarItem}"
                            Command="{Binding AbrirConfiguracoesCommand}" />
                    <Button Content="Sobre" Style="{StaticResource Button.SidebarItem}"
                            Command="{Binding AbrirSobreCommand}" />
                    <Button Content="Ajuda / Perguntas frequentes" Style="{StaticResource Button.SidebarItem}"
                            Command="{Binding AbrirFaqCommand}" />
                </StackPanel>

                <Grid DockPanel.Dock="Bottom" Margin="8,0,8,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource Button.SidebarItem}"
                            Command="{Binding AbrirPerfilCommand}" ToolTip="Ver dados da empresa e do usuário"
                            Padding="8,8" Margin="0">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource Brush.SidebarItemAtivo}">
                                <TextBlock Text="{Binding IniciaisUsuario}" Foreground="{StaticResource Brush.SidebarTexto}"
                                           FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding NomeUsuario}" Foreground="{StaticResource Brush.SidebarTextoSecundario}"
                                       FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="1" Content="Sair" Style="{StaticResource Button.SidebarItem}"
                            Command="{Binding SairCommand}" ToolTip="Sair da sua conta"
                            Foreground="{StaticResource Brush.SidebarTextoSecundario}"
                            FontSize="12" Padding="10,8" Margin="0" />
                </Grid>
            </DockPanel>
        </Border>

        <!-- Conteúdo -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Content="☰" Width="36" Height="32" Margin="12,12,0,0"
                    HorizontalAlignment="Left" Click="BotaoAlternarSidebar_Click"
                    Style="{StaticResource Button.Collapse}" />

            <Grid Grid.Row="1" x:Name="PainelConteudo" />
        </Grid>
    </Grid>
</Window>
