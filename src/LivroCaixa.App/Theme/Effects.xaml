<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Sombra discreta de elevação para cards/painéis "flutuantes" sobre o fundo da app.
         Não usar em texto ou em botões pequenos. -->
    <DropShadowEffect x:Key="Effect.CardShadow"
                      Color="#000000" Opacity="0.08"
                      Direction="270" ShadowDepth="2" BlurRadius="12" />

</ResourceDictionary>
