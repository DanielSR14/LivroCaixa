<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Cor principal do app (a mesma de Assets/livrocaixa_logo.svg e livrocaixa_icone.svg) -->
    <Color x:Key="Color.Primary">#1F4E79</Color>
    <Color x:Key="Color.PrimaryHover">#173B5C</Color>
    <Color x:Key="Color.PrimaryTint">#E3ECF5</Color>
    <Color x:Key="Color.OnPrimary">#FFFFFF</Color>

    <!-- Neutros -->
    <Color x:Key="Color.TextPrimary">#1B1B1D</Color>
    <Color x:Key="Color.TextSecondary">#5B5B60</Color>
    <Color x:Key="Color.AppBackground">#F7F7F8</Color>
    <Color x:Key="Color.SurfaceBackground">#FFFFFF</Color>
    <Color x:Key="Color.Border">#E3E3E6</Color>

    <!-- Semânticas -->
    <Color x:Key="Color.Success">#2E7D32</Color>
    <Color x:Key="Color.Warning">#ED6C02</Color>
    <Color x:Key="Color.Error">#C62828</Color>

    <!-- Sidebar -->
    <Color x:Key="Color.SidebarItemAtivo">#2B6197</Color>
    <Color x:Key="Color.SidebarTextoSecundario">#C8D8EA</Color>

    <!-- Paleta categórica (gráficos, ex: pizza de saídas por categoria) — gerada e validada
         computacionalmente contra o fundo branco dos cards (ver REESTRUTURACAO_VISUAL.md,
         seção 1.3): distinguível para daltonismo e visão normal. Usar sempre nessa ordem
         (1→7); a 8ª é reservada para a fatia agregada "Outras categorias", nunca para uma
         categoria individual. -->
    <Color x:Key="Color.Chart1">#2A78D6</Color>
    <Color x:Key="Color.Chart2">#EB6834</Color>
    <Color x:Key="Color.Chart3">#1BAF7A</Color>
    <Color x:Key="Color.Chart4">#EDA100</Color>
    <Color x:Key="Color.Chart5">#E87BA4</Color>
    <Color x:Key="Color.Chart6">#008300</Color>
    <Color x:Key="Color.Chart7">#4A3AA7</Color>
    <Color x:Key="Color.ChartOutras">#898781</Color>

    <!-- Brushes prontos para uso em XAML -->
    <SolidColorBrush x:Key="Brush.Primary" Color="{StaticResource Color.Primary}" />
    <SolidColorBrush x:Key="Brush.PrimaryHover" Color="{StaticResource Color.PrimaryHover}" />
    <SolidColorBrush x:Key="Brush.PrimaryTint" Color="{StaticResource Color.PrimaryTint}" />
    <SolidColorBrush x:Key="Brush.OnPrimary" Color="{StaticResource Color.OnPrimary}" />

    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.AppBackground" Color="{StaticResource Color.AppBackground}" />
    <SolidColorBrush x:Key="Brush.SurfaceBackground" Color="{StaticResource Color.SurfaceBackground}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />

    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.Error" Color="{StaticResource Color.Error}" />

    <SolidColorBrush x:Key="Brush.SidebarBackground" Color="{StaticResource Color.Primary}" />
    <SolidColorBrush x:Key="Brush.SidebarItemHover" Color="{StaticResource Color.PrimaryHover}" />
    <SolidColorBrush x:Key="Brush.SidebarItemAtivo" Color="{StaticResource Color.SidebarItemAtivo}" />
    <SolidColorBrush x:Key="Brush.SidebarTexto" Color="{StaticResource Color.OnPrimary}" />
    <SolidColorBrush x:Key="Brush.SidebarTextoSecundario" Color="{StaticResource Color.SidebarTextoSecundario}" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="{StaticResource Color.PrimaryTint}" />

    <SolidColorBrush x:Key="Brush.Chart1" Color="{StaticResource Color.Chart1}" />
    <SolidColorBrush x:Key="Brush.Chart2" Color="{StaticResource Color.Chart2}" />
    <SolidColorBrush x:Key="Brush.Chart3" Color="{StaticResource Color.Chart3}" />
    <SolidColorBrush x:Key="Brush.Chart4" Color="{StaticResource Color.Chart4}" />
    <SolidColorBrush x:Key="Brush.Chart5" Color="{StaticResource Color.Chart5}" />
    <SolidColorBrush x:Key="Brush.Chart6" Color="{StaticResource Color.Chart6}" />
    <SolidColorBrush x:Key="Brush.Chart7" Color="{StaticResource Color.Chart7}" />
    <SolidColorBrush x:Key="Brush.ChartOutras" Color="{StaticResource Color.ChartOutras}" />

    <!-- Sobrescreve o azul padrão do Windows para seleção (DataGrid, ListBox, ComboBox, texto
         selecionado em TextBox etc.) por um tom claro da cor principal, em vez do azul de
         sistema. Cobre qualquer controle nativo que use SystemColors.Highlight*, sem precisar
         estilizar cada um manualmente. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{StaticResource Color.PrimaryTint}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{StaticResource Color.TextPrimary}" />

</ResourceDictionary>
